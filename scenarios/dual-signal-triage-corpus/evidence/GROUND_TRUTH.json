      "ground_truth_section": "storyline",
      "emitted": true,
      "attributes": {
        "dst_ip": "10.20.30.10",
        "dst_port": 80,
        "encoding": "percent",
        "expected_sources": [
          "web_access",
          "zeek_http"
        ],
        "family": "sql_injection",
        "rendered_value": "EFORGE_TEST%27%20UNION%20SELECT%20username%2Cpassword%20FROM%20users--%20EFORGE_TEST%20p2lAzH",
        "rendered_sha256": "360d52d8d6efd59e15d70cdfb0095550519f32b08eadf4f406a9d2c700eef68d",
